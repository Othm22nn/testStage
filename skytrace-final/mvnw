#!/usr/bin/env sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_HOME="$PROJECT_DIR/.mvn/wrapper/apache-maven-3.9.9"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Maven embarque introuvable : $MAVEN_HOME/bin/mvn" >&2
  exit 1
fi

export MAVEN_HOME
exec "$MAVEN_HOME/bin/mvn" "$@"
